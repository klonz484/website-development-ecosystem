  "scripts": { "build": "tsc -p tsconfig.json", "typecheck": "tsc --noEmit -p tsconfig.json", "test": "vitest run" },
  "peerDependencies": { "react": ">=18.2.0", "react-dom": ">=18.2.0" },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.4", "@testing-library/react": "16.1.0",
    "@types/react": "18.3.18", "@types/react-dom": "18.3.5",
    "jsdom": "26.0.0", "react": "18.3.1", "react-dom": "18.3.1",
    "typescript": "5.7.3", "vitest": "2.1.8"
  }
}
