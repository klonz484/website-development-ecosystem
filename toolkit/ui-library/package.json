{
  "name": "@website-development-ecosystem/ui",
  "version": "0.1.0",
  "description": "Accessible React UI primitives and semantic design tokens.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "files": ["dist", "README.md"],
  "main": "./dist/index.js",
